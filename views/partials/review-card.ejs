<figure class="why-card review-card flex h-full flex-col">
  <%- include('stars', { n: r.rating }) %>
  <blockquote class="mt-3 flex-1 whitespace-pre-line text-ink"><%= r.text %></blockquote>
  <figcaption class="mt-4 text-sm"><span class="font-semibold"><%= r.name %></span><% if (r.trip) { %><span class="text-muted"> · <%= r.trip %></span><% } %></figcaption>
</figure>
