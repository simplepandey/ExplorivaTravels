<%
  const pageTitle = typeof title !== 'undefined' ? title : brand;
  const pageDesc = typeof description !== 'undefined' ? description : '';
  const canonical = siteUrl + (path === '/' ? '/' : path);
  const ogImg = typeof ogImage !== 'undefined' && ogImage ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage) : null;
  const hideFromSearch = typeof noindex !== 'undefined' && noindex;
%><!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="theme-color" content="#C2410C">
<% if (hideFromSearch) { %>
  <meta name="robots" content="noindex,nofollow">
<% } else { %>
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:site_name" content="<%= brand %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:url" content="<%= canonical %>">
<% if (ogImg) { %>  <meta property="og:image" content="<%= ogImg %>">
<% } %>  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
<% } %>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/app.css">
  <script src="https://cdn.tailwindcss.com/3.4.16"></script>
  <script src="/js/tailwind-config.js"></script>
  <script src="/js/init.js"></script>
</head>
<body class="bg-white text-ink antialiased">
<a href="#main" class="skip-link">Skip to content</a>
<header class="site-header sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="logo focus-ring" aria-label="<%= brand %> home">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--accent)"/><path d="M8 21c3-8 7-12 16-13-1 9-5 13-13 14l-2 3 1-4z" fill="#fff"/></svg>
      <span><%= brand %></span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm font-medium sm:gap-2">
      <a href="/trips" class="nav-link focus-ring" <%- path.startsWith('/trips') ? 'aria-current="page"' : '' %>>Trips</a>
      <a href="/reviews" class="nav-link focus-ring" <%- path === '/reviews' ? 'aria-current="page"' : '' %>>Reviews</a>
      <a href="/about" class="nav-link focus-ring" <%- path === '/about' ? 'aria-current="page"' : '' %>>About</a>
      <a href="/contact" class="nav-link focus-ring" <%- path === '/contact' ? 'aria-current="page"' : '' %>>Contact</a>
    </nav>
  </div>
</header>
<main id="main" tabindex="-1">
