<%- include('partials/top') %>
<%
  const imgs = trip.images;
  const shown = imgs.slice(0, 5);
%>
<div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
  <nav aria-label="Breadcrumb" class="text-sm text-muted"><a class="hover-link focus-ring" href="/trips">← All trips</a></nav>
  <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"><%= trip.title %></h1>
  <p class="mt-1 text-muted"><%= trip.destination %> · <%= trip.dateRange %> · <%= trip.duration %></p>

  <div class="gallery-wrap mt-6" data-lightbox data-images="<%= JSON.stringify(imgs) %>" data-title="<%= trip.title %>">
    <div class="gallery" data-count="<%= shown.length %>">
      <% shown.forEach(function (src, i) { %>
      <button type="button" class="g g<%= i %> skeleton focus-ring" data-index="<%= i %>" aria-label="Open photo <%= i + 1 %> of <%= imgs.length %>">
        <img class="lazy" src="<%= src %>" alt="<%= trip.title %> – photo <%= i + 1 %>" width="1200" height="900" <%= i === 0 ? '' : 'loading=lazy' %> decoding="async">
      </button>
      <% }) %>
    </div>
    <% if (imgs.length > 1) { %>
    <button type="button" class="btn btn-light focus-ring show-all" data-index="0">Show all <%= imgs.length %> photos</button>
    <% } %>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-semibold"><%= trip.destination %> with <%= brand %></h2>
      <p class="mt-1 text-muted"><%= trip.blurb %></p>
      <hr class="my-8 border-line">
      <h2 class="text-xl font-semibold">About this trip</h2>
      <div class="prose-trip mt-3 space-y-4 text-ink">
        <% trip.paragraphs.forEach(function (p) { %><p><%= p %></p><% }) %>
      </div>
    </div>
    <aside class="lg:col-span-1" aria-label="Enquire about this trip">
      <div class="enquire-card">
        <p><span class="text-2xl font-bold"><%= trip.priceText %></span> <span class="text-muted">per person</span></p>
        <dl class="mt-4 divide-y divide-line rounded-xl border border-line text-sm">
          <div class="flex justify-between px-4 py-3"><dt class="text-muted">Dates</dt><dd class="font-medium"><%= trip.dateRange %></dd></div>
          <div class="flex justify-between px-4 py-3"><dt class="text-muted">Duration</dt><dd class="font-medium"><%= trip.duration %></dd></div>
          <div class="flex justify-between px-4 py-3"><dt class="text-muted">Where</dt><dd class="font-medium"><%= trip.destination %></dd></div>
        </dl>
        <a href="<%= whatsappLink %>" target="_blank" rel="noopener" class="btn btn-primary focus-ring mt-5 w-full">Enquire on WhatsApp</a>
        <p class="mt-3 text-center text-xs text-muted">Or call <a class="hover-link underline" href="<%= contact.phoneHref %>"><%= contact.phone %></a></p>
      </div>
    </aside>
  </div>
</div>
<%- include('partials/bottom') %>
