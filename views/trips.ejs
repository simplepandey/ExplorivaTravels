<%- include('partials/top') %>
<section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Upcoming trips</h1>
  <p class="mt-2 text-muted">Soonest departures first.</p>
  <% if (trips.length) { %>
  <div class="trip-grid mt-10">
    <% trips.forEach(function (t) { %><%- include('partials/trip-card', { t: t }) %><% }) %>
  </div>
  <% } else { %>
  <div class="mt-10"><%- include('partials/empty') %></div>
  <% } %>
</section>
<%- include('partials/bottom') %>
