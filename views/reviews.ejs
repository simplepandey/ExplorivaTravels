<%- include('partials/top') %>
<section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8">
  <p class="eyebrow">Reviews</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">What travellers say</h1>
  <% if (reviews.length) { %>
  <p class="mt-3 flex items-center gap-2 text-muted"><%- include('partials/stars', { n: average }) %> <span><strong class="text-ink"><%= average.toFixed(1) %></strong> from <%= reviews.length %> review<%= reviews.length === 1 ? '' : 's' %></span></p>
  <% } %>

  <div class="mt-10 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <% if (reviews.length) { %>
      <div class="grid gap-6 sm:grid-cols-2">
        <% reviews.forEach(function (r) { %><%- include('partials/review-card', { r: r }) %><% }) %>
      </div>
      <% } else { %>
      <div class="empty rounded-2xl border border-dashed border-line bg-surface px-6 py-16 text-center">
        <h2 class="text-xl font-semibold">No reviews yet</h2>
        <p class="mt-2 text-muted">Travelled with us? Be the first to share your experience.</p>
      </div>
      <% } %>
    </div>

    <aside class="lg:col-span-1" aria-labelledby="write">
      <div class="enquire-card">
        <h2 id="write" class="text-xl font-semibold">Share your experience</h2>
        <% if (submitted) { %>
        <p role="status" class="mt-4 rounded-xl bg-green-50 px-4 py-3 text-sm text-green-900">Thank you! Your review will appear once we've approved it.</p>
        <% } %>
        <form method="post" action="/reviews" class="mt-4 space-y-4" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
          <div>
            <label class="label" for="r-name">Your name</label>
            <input class="input" id="r-name" name="name" maxlength="60" required value="<%= values.name || '' %>" aria-invalid="<%= !!errors.name %>">
            <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
          </div>
          <div>
            <label class="label" for="r-trip">Trip <span class="font-normal text-muted">(optional)</span></label>
            <input class="input" id="r-trip" name="trip" maxlength="120" value="<%= values.trip || '' %>">
            <% if (errors.trip) { %><p class="field-error"><%= errors.trip %></p><% } %>
          </div>
          <fieldset>
            <legend class="label">Rating</legend>
            <div class="rating-input">
              <% for (let i = 5; i >= 1; i--) { %>
              <input type="radio" id="star<%= i %>" name="rating" value="<%= i %>" <%= String(values.rating) === String(i) ? 'checked' : '' %> required>
              <label for="star<%= i %>" title="<%= i %> star<%= i === 1 ? '' : 's' %>"><span class="sr-only"><%= i %> star<%= i === 1 ? '' : 's' %></span><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18l-6.5 4 1.7-7.4-5.7-5 7.5-.7z"/></svg></label>
              <% } %>
            </div>
            <% if (errors.rating) { %><p class="field-error"><%= errors.rating %></p><% } %>
          </fieldset>
          <div>
            <label class="label" for="r-text">Your review</label>
            <textarea class="input" id="r-text" name="text" rows="5" maxlength="1000" required><%= values.text || '' %></textarea>
            <% if (errors.text) { %><p class="field-error"><%= errors.text %></p><% } %>
          </div>
          <button class="btn btn-primary focus-ring w-full" type="submit">Submit review</button>
          <p class="text-xs text-muted">Reviews are checked before they're published.</p>
        </form>
      </div>
    </aside>
  </div>
</section>
<%- include('partials/bottom') %>
