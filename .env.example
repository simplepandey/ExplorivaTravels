# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
SITE_URL=https://explorivatravels.com

# Contact details (used on the Contact page, footer and WhatsApp buttons)
CONTACT_EMAIL=explorivatravels@gmail.com
CONTACT_PHONE=+91 80971 94290
# Digits only, country code included, no "+": used in https://wa.me/<number>
WHATSAPP_NUMBER=918097194290

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# bcrypt hash of the admin password. Generate with:  node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# Behind nginx/Caddy/a load balancer set to 1 (default in production) so HTTPS is detected.
# TRUST_PROXY=1
# TIMEZONE=Asia/Kolkata
